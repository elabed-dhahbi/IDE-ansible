#!/bin/bash
# DMC Service Control Script
# Generated by Ansible

DMC_HOME="{{ dmc_install_dir }}"
DMC_CONFIG="{{ dmc_config_dir }}/dmc.conf"
DMC_PID="{{ dmc_data_dir }}/dmc.pid"
JAVA_HOME="{{ java_home }}/current"
JAVA_OPTS="{{ java_opts }}"

# Source configuration
if [ -f "$DMC_CONFIG" ]; then
    source "$DMC_CONFIG"
fi

start() {
    echo "Starting DMC..."
    if [ -f "$DMC_PID" ]; then
        echo "DMC is already running (PID: $(cat $DMC_PID))"
        return 1
    fi
    
    cd "$DMC_HOME"
    nohup "$JAVA_HOME/bin/java" $JAVA_OPTS -jar "$DMC_HOME/lib/dmc.jar" --spring.config.location="$DMC_CONFIG" > "$DMC_HOME/logs/dmc.out" 2>&1 &
    echo $! > "$DMC_PID"
    echo "DMC started (PID: $(cat $DMC_PID))"
}

stop() {
    echo "Stopping DMC..."
    if [ -f "$DMC_PID" ]; then
        PID=$(cat "$DMC_PID")
        kill "$PID"
        rm -f "$DMC_PID"
        echo "DMC stopped"
    else
        echo "DMC is not running"
    fi
}

restart() {
    stop
    sleep 2
    start
}

status() {
    if [ -f "$DMC_PID" ]; then
        PID=$(cat "$DMC_PID")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "DMC is running (PID: $PID)"
        else
            echo "DMC is not running (stale PID file)"
            rm -f "$DMC_PID"
        fi
    else
        echo "DMC is not running"
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac




