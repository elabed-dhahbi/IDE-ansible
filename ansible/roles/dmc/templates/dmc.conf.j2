# DMC Configuration File
# Generated by Ansible

# Server configuration
server.port={{ dmc_http_port }}
server.host={{ dmc_http_host }}
server.node_id={{ dmc_node_id }}

# Database configuration
database.host={{ dmc_database_host }}
database.port={{ dmc_database_port }}
database.name={{ dmc_database_name }}
database.user={{ dmc_database_user }}
database.password={{ dmc_database_password }}

# Elasticsearch configuration
elasticsearch.host={{ dmc_elasticsearch_host }}
elasticsearch.port={{ dmc_elasticsearch_port }}

# Logging configuration
logging.level={{ dmc_logging_level }}
logging.file={{ dmc_logging_file }}
logging.max_size={{ dmc_logging_max_size }}
logging.max_files={{ dmc_logging_max_files }}

# Java configuration
java.home={{ java_home }}/current
java.opts={{ java_opts }}



