# Kibana Configuration File
# Generated by Ansible

# Server configuration
server.host: "{{ kibana_config.server_host }}"
server.port: {{ kibana_config.server_port }}
server.name: "{{ kibana_config.server_name }}"
{% if kibana_config.server_base_path is defined %}
server.basePath: "{{ kibana_config.server_base_path }}"
{% endif %}
{% if kibana_config.server_public_base_url is defined %}
server.publicBaseUrl: "{{ kibana_config.server_public_base_url }}"
{% endif %}
{% if kibana_config.server_rewrite_base_path is defined %}
server.rewriteBasePath: {{ kibana_config.server_rewrite_base_path | lower }}
{% endif %}

# Elasticsearch configuration
elasticsearch.hosts: {{ kibana_config.elasticsearch_hosts | to_json }}
elasticsearch.username: "{{ kibana_config.elasticsearch_username }}"
elasticsearch.password: "{{ kibana_config.elasticsearch_password }}"

# Security configuration
xpack.security.enabled: {{ kibana_config.xpack_security_enabled | lower }}
{% if kibana_config.xpack_encryption_key is defined %}
xpack.security.encryptionKey: "{{ kibana_config.xpack_encryption_key }}"
{% endif %}
{% if kibana_config.xpack_security_session_idle_timeout is defined %}
xpack.security.session.idleTimeout: "{{ kibana_config.xpack_security_session_idle_timeout }}"
{% endif %}
{% if kibana_config.xpack_security_session_lifespan is defined %}
xpack.security.session.lifespan: "{{ kibana_config.xpack_security_session_lifespan }}"
{% endif %}
{% if kibana_config.xpack_reporting_encryption_key is defined %}
xpack.reporting.encryptionKey: "{{ kibana_config.xpack_reporting_encryption_key }}"
{% endif %}

# Data directory
path.data: {{ kibana_data_dir }}

# Logging configuration
logging.appenders:
  file:
    type: file
    fileName: "{{ kibana_logs_dir }}/kibana.log"
    layout:
      type: json

logging.loggers:
  - name: http.server.response
    appenders:
      - file
    level: error
  - name: http.server.response
    appenders:
      - file
    level: error
  - name: http.server.response
    appenders:
      - file
    level: error

# Monitoring configuration
monitoring.ui.container.elasticsearch.enabled: true
monitoring.ui.container.logstash.enabled: true

# Saved objects encryption
{% if kibana_config.xpack_encrypted_saved_objects_encryption_key is defined %}
xpack.encryptedSavedObjects.encryptionKey: "{{ kibana_config.xpack_encrypted_saved_objects_encryption_key }}"
{% endif %}