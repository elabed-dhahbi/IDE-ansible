# JVM Configuration for OpenSearch
# Generated by Ansible - DO NOT EDIT MANUALLY
# This file is managed by Ansible playbook

# Heap Size Configuration
-Xms{{ opensearch_jvm.heap_size }}
-Xmx{{ opensearch_jvm.heap_size }}

# Garbage Collection
-XX:+UseG1GC

# GC Logging
{% if opensearch_config.gc_log_path is defined %}
-Xlog:gc*:{{ opensearch_config.gc_log_path }}:time
{% else %}
-Xlog:gc*:/var/log/opensearch/gc.log:time
{% endif %}

# Compressed OOPs
-XX:+UseCompressedOops

