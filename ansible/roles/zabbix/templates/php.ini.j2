# PHP Configuration for Zabbix
# Generated by Ansible

# Basic settings
date.timezone = {{ zabbix_apache.php_timezone }}
memory_limit = 256M
max_execution_time = 300
post_max_size = 32M
upload_max_filesize = 16M

# Required extensions for Zabbix
extension=gd
extension=bcmath
extension=ldap
extension=mbstring
extension=pgsql
extension=xml

# Other settings
max_input_time = 300
default_socket_timeout = 300



