# Zabbix Agent Configuration
# Generated by Ansible

PidFile=/run/zabbix/zabbix_agentd.pid

LogFile=/var/log/zabbix/zabbix_agentd.log
LogFileSize=0

Server={{ hostvars[groups['zabbix'][0]]['ansible_host'] if groups['zabbix'] is defined and groups['zabbix'] | length > 0 else '127.0.0.1' }}
ServerActive={{ hostvars[groups['zabbix'][0]]['ansible_host'] if groups['zabbix'] is defined and groups['zabbix'] | length > 0 else '127.0.0.1' }}

Hostname={{ inventory_hostname }}

ListenPort=10050
ListenIP=0.0.0.0

Include=/etc/zabbix/zabbix_agentd.d/*.conf

# Performance settings
StartAgents=3
RefreshActiveChecks=120
DisableActive=0
DisablePassive=0

# Timeout settings
Timeout=3

# Buffer settings
BufferSize=100
BufferSend=5

# Logging settings
DebugLevel=3
EnableRemoteCommands=0
LogRemoteCommands=0

# User settings
User={{ zabbix_user }}

# TLS settings
TLSCAFile=
TLSCertFile=
TLSKeyFile=

# Other settings
AllowRoot=0
Include=/etc/zabbix/zabbix_agentd.conf.d/*.conf


