# Zabbix Apache Virtual Host Configuration
# Generated by Ansible

<VirtualHost *:{{ zabbix_apache.listen_port }}>
    ServerName {{ zabbix_apache.server_name }}
    DocumentRoot {{ zabbix_apache.document_root }}
    
    <Directory "{{ zabbix_apache.document_root }}">
        AllowOverride None
        Require all granted
    </Directory>
    
    <Directory "{{ zabbix_apache.document_root }}/conf">
        Require all denied
    </Directory>
    
    <Directory "{{ zabbix_apache.document_root }}/app">
        Require all denied
    </Directory>
    
    <Directory "{{ zabbix_apache.document_root }}/include">
        Require all denied
    </Directory>
    
    <Directory "{{ zabbix_apache.document_root }}/local">
        Require all denied
    </Directory>
    
    ErrorLog /var/log/httpd/zabbix_error.log
    CustomLog /var/log/httpd/zabbix_access.log combined
</VirtualHost>



























